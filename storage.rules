rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public Assets (Thumbnails, Free Files)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Protected Paid Maps Folder: STRICTLY NO DIRECT PUBLIC ACCESS
    // Download access is ONLY served via Firebase Cloud Functions Signed URLs
    match /paid_maps/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}